# Copy to .env next to manage.py. It is loaded automatically by the settings;
# variables already set in the real environment take precedence.
# Never commit .env.
#
# Which settings module runs is NOT set here: manage.py uses config.settings.dev,
# and wsgi.py / asgi.py use config.settings.prod.

# Required in production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Optional
DJANGO_LANGUAGE_CODE=en
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=webmaster@example.com
